{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Simulation": {
    "Enabled": true,
    "SeedHistory": true,
    "HistoryDays": 14,
    "HistoryJobsPerDay": 90,
    "TickMilliseconds": 1000,
    "MaxConcurrentJobs": 6,
    "ArrivalRate": 0.6,
    "FailureRate": 0.12
  }
}
